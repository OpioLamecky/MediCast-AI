# Environment Variables for MediCast Inference Server
# Copy this file to .env and configure as needed

# Server Config
PORT=8000
HOST=0.0.0.0
RELOAD=true

# Database Config (PostgreSQL for session state and black box audit)
# Example: DATABASE_URL=postgresql://user:pass@localhost:5432/medicast
DATABASE_URL=

# Redis Config (For real-time WebSocket pub/sub)
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# AI Backend Configuration (Powered by LiteLLM)
# To use Fireworks AI (Default):
FIREWORKS_API_KEY=
# To use Claude:
# TEXT_MODEL="anthropic/claude-3-5-sonnet-20240620"
# ANTHROPIC_API_KEY=your_key_here
# To use Ollama (Local):
# TEXT_MODEL="ollama/llama3"
# OLLAMA_API_BASE="http://localhost:11434"
