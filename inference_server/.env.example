# ──────────────────────────────────────────────
# MediCast Inference Server — Environment Variables
# Copy this file to .env and fill in your keys.
# ──────────────────────────────────────────────

# Server Config
PORT=8000
HOST=0.0.0.0
RELOAD=true

# Database Config (PostgreSQL for session state and black box audit)
# Example: DATABASE_URL=postgresql://user:pass@localhost:5432/medicast
DATABASE_URL=

# Redis Config (For real-time WebSocket pub/sub)
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ──────────────────────────────────────────────
# AI Backend Configuration (Powered by LiteLLM)
# ──────────────────────────────────────────────
# The inference engine tries providers in order until one succeeds:
#   1. Groq       — Free tier, Llama 3.3 70B (~6K req/day)
#   2. Gemini     — Free tier, Gemini 2.0 Flash (~15 req/min)
#   3. HuggingFace — Free serverless models (last resort)
#
# Get your FREE keys:
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey

GROQ_API_KEY=
GEMINI_API_KEY=
FIREWORKS_API_KEY=
HUGGINGFACE_API_KEY=

# Optional: Override the primary text model (tried first before fallback chain)
# TEXT_MODEL=groq/llama-3.3-70b-versatile

# Other supported models via LiteLLM:
# TEXT_MODEL="anthropic/claude-3-5-sonnet-20240620"  (needs ANTHROPIC_API_KEY)
# TEXT_MODEL="ollama/llama3"                         (needs OLLAMA_API_BASE)
# TEXT_MODEL="openai/gpt-4o"                         (needs OPENAI_API_KEY)
